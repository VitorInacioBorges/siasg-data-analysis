# ===========================================================================
# Compras.gov.br open data API
# Docs: https://dadosabertos.compras.gov.br/swagger-ui/index.html
# No API key is required for this endpoint.
# ===========================================================================
API_BASE_URL=https://dadosabertos.compras.gov.br
ITEMS_ENDPOINT=/modulo-contratacoes/2_consultarItensContratacoes_PNCP_14133

# ===========================================================================
# Time window
# END_DATE    last day of the window, YYYY-MM-DD. Empty = today.
# WINDOW_DAYS fixed length in days. 365 gives a one-year window that ignores
#             leap years, as requested.
# CHUNK_DAYS  the window is split into chunks of this size; each chunk is
#             fetched and flushed to disk independently, so a crash only
#             costs the current chunk. Smaller = safer, more requests.
# ===========================================================================
END_DATE=
WINDOW_DAYS=365
CHUNK_DAYS=7

# ===========================================================================
# Pagination
# PAGE_SIZE      records per request. Bigger = fewer requests for the same
#                data, so the whole run is faster.
# PAGE_SIZE_MIN  the accepted range, checked at startup so a bad value fails
# PAGE_SIZE_MAX  in the first second instead of as an HTTP 400 hours in.
#                These are the limits the API itself enforces — raising
#                PAGE_SIZE_MAX does not make the API accept more.
# ===========================================================================
PAGE_SIZE=500
PAGE_SIZE_MIN=10
PAGE_SIZE_MAX=500

# ===========================================================================
# Optional API filters — leave empty to fetch everything.
# Measured volume for a single day, to size your run:
#   no filter                 ~13,800 items/day  (~5.0M per year)
#   ITEM_STATUS=2             ~11,000 items/day  (~4.0M per year)
#   MATERIAL_OR_SERVICE=S      ~3,600 items/day  (~1.3M per year)
#
# MATERIAL_OR_SERVICE  M = material, S = service
# ITEM_STATUS          1 = em andamento, 2 = homologado, 3 = anulado/revogado
# HAS_RESULT           true = only items with an awarded supplier
# ORGAN_CNPJ           CNPJ of the contracting body, digits only
# UNIT_CODE            UASG code of the contracting unit
# ITEM_GROUP           CATMAT/CATSER group code
# ITEM_CLASS           CATMAT/CATSER class code
# CATALOG_ITEM         specific catalog item code
# SUPPLIER_ID          supplier CNPJ/CPF
# ===========================================================================
MATERIAL_OR_SERVICE=S
ITEM_STATUS=2
HAS_RESULT=
ORGAN_CNPJ=
UNIT_CODE=
ITEM_GROUP=
ITEM_CLASS=
CATALOG_ITEM=
SUPPLIER_ID=

# ===========================================================================
# Columns to keep. Empty = every field the API returns (45 columns).
# The subset below covers a "what did the government spend on" analysis and
# cuts the output file to roughly a third of the full size.
# ===========================================================================
COLUMNS=idCompraItem,dataInclusaoPncp,orgaoEntidadeCnpj,unidadeOrgaoCodigoUnidade,materialOuServico,materialOuServicoNome,itemCategoriaNome,codigoGrupo,codigoClasse,codItemCatalogo,descricaoResumida,unidadeMedida,quantidade,valorUnitarioEstimado,valorTotal,temResultado,valorTotalResultado,nomeFornecedor,situacaoCompraItemNome

# ===========================================================================
# HTTP behaviour
# REQUEST_DELAY  seconds between successful requests (the API tolerates back
#                to back calls, but be a good citizen on a 10k-request run)
# RETRY_BACKOFF  base seconds to wait after a 429/5xx/dropped connection;
#                grows linearly with each attempt
# MAX_WORKERS    chunks downloaded at the same time. Measured ceiling for this
#                API is 2-4; at 8 it degrades and beyond that it returns 429
#                in bulk, which the backoff then turns into a slower run.
# ===========================================================================
REQUEST_TIMEOUT=60
REQUEST_DELAY=0
MAX_RETRIES=5
RETRY_BACKOFF=15
MAX_WORKERS=2

# ===========================================================================
# Output
# RESUME              true = skip chunks already recorded in the checkpoint
#                     file, so an interrupted run picks up where it stopped.
#                     Set to false to start over (deletes the existing CSV).
# TOP_ITEMS           rows printed in each summary ranking.
# SUMMARY_CHUNK_ROWS  rows the summary reads at a time. The CSV can hold
#                     millions of rows, so it is read in slices and peak
#                     memory follows one slice, not the file. Lower it on a
#                     machine with little RAM.
# ===========================================================================
OUTPUT_CSV=data/contract_items.csv
CHECKPOINT_FILE=data/checkpoint.json
RESUME=true
TOP_ITEMS=20
SUMMARY_CHUNK_ROWS=200_000
